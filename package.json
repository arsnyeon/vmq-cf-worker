{
  "name": "vmq-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev -c \"$(node scripts/cfg.mjs)\"",
    "deploy": "pnpm admin:build && pnpm web:build && wrangler deploy -c \"$(node scripts/cfg.mjs)\"",
    "typecheck": "tsc --noEmit",
    "test:web": "pnpm --filter @vmq/web typecheck",
    "test:md5": "node --experimental-strip-types test/md5.check.mjs",
    "test:notify": "node --experimental-strip-types test/notify.check.mjs",
    "test:forwarded": "node --experimental-strip-types test/forwarded.check.mjs",
    "test:params": "node --experimental-strip-types test/params.check.mjs",
    "test:smoke": "node test/smoke.http.mjs",
    "db:create": "wrangler d1 create vmq",
    "db:local": "wrangler d1 execute vmq --local -c \"$(node scripts/cfg.mjs)\" --file=./schema.sql",
    "db:remote": "wrangler d1 execute vmq --remote -c \"$(node scripts/cfg.mjs)\" --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute vmq --local -c \"$(node scripts/cfg.mjs)\" --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute vmq --remote -c \"$(node scripts/cfg.mjs)\" --file=./seed.sql",
    "test": "pnpm typecheck && pnpm test:web && pnpm test:pay && pnpm test:qr && pnpm test:md5 && pnpm test:notify && pnpm test:forwarded && pnpm test:params && pnpm test:alias && pnpm test:http",
    "test:pay": "node --experimental-strip-types test/pay.check.mjs",
    "test:qr": "node --experimental-strip-types test/qr.decode.mjs && node --experimental-strip-types test/qr.check.mjs",
    "admin": "node scripts/reset-admin.mjs",
    "test:alias": "node --experimental-strip-types test/alias.check.mjs",
    "check:leak": "node scripts/check-leak.mjs",
    "test:api": "node test/api.admin.check.mjs",
    "admin:dev": "pnpm --filter @vmq/admin dev",
    "admin:build": "pnpm --filter @vmq/admin build",
    "web:dev": "pnpm --filter @vmq/web dev",
    "web:build": "pnpm --filter @vmq/web build",
    "dev:all": "pnpm admin:build && pnpm web:build && pnpm dev",
    "test:http": "node test/smoke.http.mjs",
    "verify": "pnpm typecheck && pnpm test:web && pnpm test:pay && pnpm test:qr && pnpm test:md5 && pnpm test:notify && pnpm test:forwarded && pnpm test:params && pnpm test:alias && pnpm test:http && pnpm test:admin"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
